# Dev proxy target (vite forwards /api -> this host)
VITE_API_PROXY_TARGET=http://127.0.0.1:8402

# Optional: bake a default API base into the renderer (overridden by Settings UI)
# VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:8402

# Enable POST actions in seller wizard (server must also set DASHBOARD_ACTIONS=true)
# VITE_DASHBOARD_ACTIONS=true
